# Copia este archivo como .env antes de levantar Docker Compose:
#   cp .env.example .env
# No subas el archivo .env con credenciales reales al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=voxify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=voxify_dev_pass
POSTGRES_PORT=5432

# --- Backend .NET ---
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5173
BACKEND_URL=http://localhost:5173
APP_SECRET_KEY=voxify_dev_secret_key_cambiar_en_produccion
AUTO_MIGRATE=true
ALLOW_DEV_USER=false

# --- Frontend (Nginx) y CORS ---
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:8080
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=SameAsRequest

# --- Proveedores OAuth 2.0 (reemplazar con credenciales reales) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# --- Autorización de Reportes (Punto 2) ---
REPORT_ALLOWED_PROVIDERS=Twitch
REPORT_ALLOWED_USERS=
