# Copia este archivo como .env antes de levantar Docker Compose:
#   cp .env.example .env
# No subas el archivo .env con credenciales reales al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=voxify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=voxify_dev_pass
POSTGRES_PORT=5432

# --- Backend .NET ---
ASPNETCORE_ENVIRONMENT=Development
BACKEND_PORT=5173
AUTO_MIGRATE=true

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Proveedores OAuth 2.0 (reemplazar con credenciales reales) ---
TWITCH_CLIENT_ID=tu_twitch_client_id
TWITCH_CLIENT_SECRET=tu_twitch_client_secret
MICROSOFT_CLIENT_ID=tu_microsoft_client_id
MICROSOFT_CLIENT_SECRET=tu_microsoft_client_secret

# --- Autorización de Reportes (Punto 2) ---
REPORT_ALLOWED_PROVIDERS=Twitch
REPORT_ALLOWED_USERS=
