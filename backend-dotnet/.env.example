# Base de datos
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=VoxifyDB;Username=postgres;Password=CAMBIAR"

# Sesión propia de Voxify
APP_SECRET_KEY=clave_secreta_larga_y_aleatoria
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5174,http://localhost:8080

# Cookies (usar None + Always solo con HTTPS en dominios distintos)
COOKIE_SAME_SITE=Lax
COOKIE_SECURE=SameAsRequest

# Acceso de desarrollo (útil mientras no hay credenciales OAuth)
ALLOW_DEV_USER=true

# TikTok Login Kit
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:5173/auth/tiktok/callback

# Microsoft Entra ID
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback

# Twitch
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5173/auth/twitch/callback
